{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "licenseFile": null,
    "icon": ["icons/macos/icon.icns"],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "contentTypes": ["net.daringfireball.markdown"],
        "name": "Markdown Document",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 190
        }
      }
    }
  }
}
